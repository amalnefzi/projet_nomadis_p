{
  "name": "optimisation_tournee_api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/health').then(r=>{if(!r.ok)process.exit(1);return r.json()}).then(j=>console.log(j)).catch(()=>process.exit(1))\"",
    "test": "pytest tests/test_coverage_optimizer.py && node --test tests/coverage_capacity_policy.test.cjs tests/client_identity_resolution.test.cjs",
    "test:coverage-capacity": "node --test tests/coverage_capacity_policy.test.cjs",
    "test:coverage-optimizer": "pytest tests/test_coverage_optimizer.py",
    "test:client-identity": "node --test tests/client_identity_resolution.test.cjs",
    "coverage-history-cache:stats": "node scripts/coverage_cache_cli.cjs history stats",
    "coverage-history-cache:clear": "node scripts/coverage_cache_cli.cjs history clear",
    "coverage-purchase-cache:stats": "node scripts/coverage_cache_cli.cjs purchase stats",
    "coverage-purchase-cache:clear": "node scripts/coverage_cache_cli.cjs purchase clear"
  },
  "keywords": [],
