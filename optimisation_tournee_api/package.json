  "description": "",
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mysql2": "^3.18.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  }
}
